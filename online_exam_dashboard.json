{
  "dashboard": {
    "id": null,
    "uid": "online-exam-dashboard",
    "title": "Online Exam System Monitoring",
    "timezone": "browser",
    "panels": [
      {
        "type": "stat",
        "title": "Pod Status",
        "gridPos": {"x":0,"y":0,"w":12,"h":6},
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "up{namespace=\"online-exam\"}",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {"mode":"thresholds"}
          }
        }
      },
      {
        "type": "graph",
        "title": "CPU Usage",
        "gridPos": {"x":0,"y":6,"w":12,"h":6},
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"online-exam\",container!=\"\"}[1m])) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "B"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Memory Usage",
        "gridPos": {"x":0,"y":12,"w":12,"h":6},
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace=\"online-exam\",container!=\"\"}) by (pod)",
            "legendFormat": "{{pod}}",
            "refId": "C"
          }
        ]
      }
    ],
    "schemaVersion": 36,
    "version": 1
  }
}
